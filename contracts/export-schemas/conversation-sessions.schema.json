{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conversation-sessions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
